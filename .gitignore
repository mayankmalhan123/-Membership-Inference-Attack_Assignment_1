# Data files (large; download with the wget commands in README §1)
# GitHub blocks files >100MB, so keep these out of commits.
priv.pt
pub.pt

# Treat other checkpoints as local by default.
*.pt

# Allow committing the smaller public model if needed.
!model.pt

# Cluster / pipeline state and logs
shadows/
shadows_aug/
reference/
multi_reference/
lira_cache/
lira_cache_aug/
runlogs/
candidates/
submissions/
pipeline_state.json
pipeline_state.tmp
STATUS.md
STATUS.md.tmp
REPORT_DRAFT.md.tmp

# Submission artefacts (regenerated by the pipeline)
submission.csv
submission_*.csv
submission_oof_pub.csv

# API key — never commit
.submission_api_key

# Python
__pycache__/
*.pyc
*.pyo
.python-version

# OS / editor
.DS_Store
.idea/
.vscode/
